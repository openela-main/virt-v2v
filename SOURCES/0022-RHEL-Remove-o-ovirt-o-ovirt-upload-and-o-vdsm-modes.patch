-        if idle:
-            now = time.monotonic()
-            for item in idle:
-                if item.last_used and now - item.last_used > IDLE_TIMEOUT:
-                    nbdkit.debug("poolkeeper: flushing idle connection")
-                    try:
-                        send_flush(item.http)
-                        item.last_used = now
-                    except Exception as e:
-                        # We will report this error on the next request.
-                        pool_error = e
-                        item.last_used = None
